{
  "name": "@cascateer/sterio-server",
  "private": true,
  "scripts": {
    "semver-patch": "npm version patch && git push origin main --tags",
    "update": "npm cache clean --force && npx ncu -u --format time && npm i",
    "start": "tsx src/main.ts",
    "cli": "tsx src/client.ts",
    "dev": "tsx src/app.ts",
    "tsoa": "tsoa spec-and-routes && npx openapi-generator-cli generate",
    "test": "vitest"
  },
  "exports": {
    "./api": "./src/api/index.ts"
  },
  "dependencies": {
    "@cascateer/lib": "*",
    "@inquirer/prompts": "^8.5.2",
    "cors": "^2.8.6",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "filenamify": "^7.0.2",
    "folder-hash": "^4.1.3",
    "googleapis": "^174.0.0",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "node-id3": "^0.2.9",
    "object-hash": "^3.0.0",
    "ora": "^9.4.1",
    "rxjs": "^7.8.2",
    "spotify-web-api-node": "^5.0.2",
    "tsoa": "^7.0.0-alpha.0",
    "uuid": "^14.0.1",
    "ytdlp-nodejs": "^3.4.5",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/folder-hash": "^4.0.4",
    "@types/lodash": "^4.17.25",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.2",
    "@types/object-hash": "^3.0.6",
    "@types/spotify-web-api-node": "^5.0.11",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
